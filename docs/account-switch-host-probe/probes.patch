+// PROBE (not for upstream): the renderer's account-restart queue (stock 1.4.272).
+import { describe, expect, it } from 'vitest'
+import { createTerminalRestartActions } from '@/store/terminals/pty/terminal-restart-state'
+
+describe('PROBE B2: renderer restart queue', () => {
+  it('queues ptyId → provider only; duplicates collapse; nothing names a destination account', () => {
+    let state = { pendingPaneAccountRestarts: {} as Record<string, string>, codexRestartNoticeByPtyId: {} as Record<string, unknown> }
+    const set = (fn: (s: typeof state) => Partial<typeof state> | typeof state) => {
+      state = { ...state, ...fn(state) }
+    }
+    const actions = createTerminalRestartActions(set as never, (() => state) as never)
+    actions.queuePaneAccountRestarts(['pty-w1'], 'claude')
+    actions.queuePaneAccountRestarts(['pty-w1'], 'claude') // duplicate trigger
+    console.log(`[probe] queue after duplicate trigger ${JSON.stringify(state.pendingPaneAccountRestarts)}`)
+    expect(state.pendingPaneAccountRestarts).toEqual({ 'pty-w1': 'claude' })
+    expect(actions.consumePendingPaneAccountRestart('pty-w1')).toBe('claude')
+    expect(actions.consumePendingPaneAccountRestart('pty-w1')).toBeNull()
+  })
