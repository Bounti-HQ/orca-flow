+++ b/src/main/account-switch-probe/stock-switch-semantics.probe.test.ts
@@ -0,0 +1,189 @@
+// PROBE (not for upstream): stock 1.4.272 account-switch semantics with synthetic managed
+// identities, temp homes and a fixture `claude` executable. No real auth files are read: every
+// account home is an empty temp folder and no Claude binary is run.
+import { execFileSync, spawn } from 'node:child_process'
+import { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+import { ClaudeProfileRouter, type ClaudeProfileRouterSettings } from '../claude-accounts/profiles/routing/claude-profile-router'
+import { getPosixClaudeShellFunction } from '../../shared/shell/launch/agents/claude-shell-function'
+import { mergeClaudeProfileDirectory } from '../claude-accounts/profiles/setup/claude-profile-history'
+import { createClaudeProfileReport } from '../claude-accounts/profiles/claude-profile-report'
+import { buildAgentResumeStartupPlan } from '../../shared/agent-launch/startup/tui-agent-resume-startup'
+import { rateLimitShowsRoom, rateLimitSpentUntil } from '../../shared/agent-usage/rate-limits/rate-limit-spent-windows'
+import type { ProviderRateLimits } from '../../shared/agent-usage/rate-limits/rate-limit-types'
+import { resolveClaudePaneFolder } from '../../shared/agent-accounts/claude/claude-pane-account-folder'
+
+const log = (label: string, value: unknown): void => console.log(`[probe] ${label} ${JSON.stringify(value)}`)
+
+let root: string
+let dataRoot: string
+let userHome: string
+let worktree: string
+let fnFile: string
+let binDir: string
+let settings: ClaudeProfileRouterSettings
+let router: ClaudeProfileRouter
+
+function account(id: string) {
+  return {
+    id,
+    email: `${id}@example.invalid`,
+    managedAuthPath: join(dataRoot, 'claude-profiles', id, 'home'),
+    authMethod: 'subscription-oauth' as const,
+    createdAt: 1,
+    updatedAt: 1,
+    lastAuthenticatedAt: 1
+  }
+}
+
+/** Runs `claude <args>` the way a pane's shell does: Orca's shell function, then the fixture binary. */
+function paneRun(env: Record<string, string | undefined>, args: string[]): { configDir: string | null; argv: string[]; cwd: string } {
+  const out = execFileSync('/bin/bash', ['-c', `source "${fnFile}"; cd "${worktree}"; claude "$@"`, 'pane', ...args], {
+    env: { PATH: `${binDir}:/usr/bin:/bin`, HOME: userHome, ...env } as NodeJS.ProcessEnv,
+    encoding: 'utf8'
+  })
+  return JSON.parse(out.trim())
+}
+
+beforeAll(() => {
+  root = mkdtempSync(join(tmpdir(), 'orca-switch-probe-'))
+  dataRoot = join(root, 'orca-data')
+  userHome = join(root, 'home')
+  worktree = join(root, 'worktree-original')
+  binDir = join(root, 'bin')
+  for (const dir of [dataRoot, userHome, join(userHome, '.claude'), worktree, binDir]) mkdirSync(dir, { recursive: true })
+  // Fixture `claude`: reports the account folder it was started with, its argv and cwd. Nothing else.
+  const fixture = join(binDir, 'claude')
+  writeFileSync(
+    fixture,
+    `#!${process.execPath}\nconst a=process.argv.slice(2);const r={configDir:process.env.CLAUDE_CONFIG_DIR??null,argv:a,cwd:process.cwd()};\nif(a[0]==='--hold'){process.stdout.write(JSON.stringify(r)+'\\n');process.stdin.on('data',()=>{});process.stdin.on('end',()=>{process.stdout.write(JSON.stringify({...r,at:'exit',configDir:process.env.CLAUDE_CONFIG_DIR??null})+'\\n')})}else{process.stdout.write(JSON.stringify(r)+'\\n')}\n`
+  )
+  chmodSync(fixture, 0o755)
+  fnFile = join(root, 'orca-claude-fn.sh')
+  writeFileSync(fnFile, getPosixClaudeShellFunction())
+  settings = {
+    claudeManagedAccounts: [account('acct_a'), account('acct_b')],
+    activeClaudeManagedAccountId: 'acct_a',
+    activeClaudeManagedAccountIdsByRuntime: { host: 'acct_a', wsl: {} },
+    agentStatusHooksEnabled: false,
+    disabledTuiAgents: []
+  } as unknown as ClaudeProfileRouterSettings
+  for (const a of settings.claudeManagedAccounts) mkdirSync(a.managedAuthPath, { recursive: true })
+  router = new ClaudeProfileRouter({
+    getSettings: () => settings,
+    dataRoot,
+    userHome,
+    env: { HOME: userHome },
+    runSetup: async () => ({ outcome: 'prepared', warnings: [] }) as never
+  })
+})
+afterAll(() => rmSync(root, { recursive: true, force: true }))
+
+function select(id: string): void {
+  settings = { ...settings, activeClaudeManagedAccountId: id, activeClaudeManagedAccountIdsByRuntime: { host: id, wsl: {} } } as never
+  router.publish()
+}
+
+describe('PROBE A: which account a Claude terminal resume runs on (stock)', () => {
+  it('one host-wide pointer decides every pane, read at each launch; a running process keeps its own', async () => {
+    const homeA = settings.claudeManagedAccounts[0]!.managedAuthPath
+    const homeB = settings.claudeManagedAccounts[1]!.managedAuthPath
+    const paneEnv = router.terminalEnv() as Record<string, string>
+    log('pane env at spawn (selected=acct_a)', { pointer: paneEnv.ORCA_CLAUDE_PROFILE_POINTER?.replace(root, '$T'), CLAUDE_CONFIG_DIR: paneEnv.CLAUDE_CONFIG_DIR?.replace(root, '$T') })
+    expect(readFileSync(router.pointerPath, 'utf8')).toBe(homeA)
+
+    // Pane W runs the worker conversation, started under acct_a and still running.
+    const running = spawn('/bin/bash', ['-c', `source "${fnFile}"; cd "${worktree}"; claude --hold`], {
+      env: { PATH: `${binDir}:/usr/bin:/bin`, HOME: userHome, ...paneEnv }
+    })
+    const lines: string[] = []
+    running.stdout.on('data', (b) => lines.push(...String(b).trim().split('\n')))
+    await new Promise((r) => setTimeout(r, 400))
+
+    select('acct_b') // Usage menu / `orca account select`: host-wide
+    expect(readFileSync(router.pointerPath, 'utf8')).toBe(homeB)
+
+    // The pane restart types `claude --resume <id>` into a fresh shell with the SAME spawn env as before.
+    const resumed = paneRun(paneEnv, ['--resume', 'sess-worker-1'])
+    // An unrelated pane launching fresh meanwhile, also with an env minted under acct_a.
+    const unrelated = paneRun(paneEnv, [])
+    running.stdin.end()
+    await new Promise((r) => running.on('close', r))
+    const runningSeen = lines.map((l) => JSON.parse(l))
+    log('running pane (started before switch)', runningSeen.map((x) => ({ at: x.at ?? 'start', configDir: x.configDir?.replace(root, '$T') })))
+    log('restarted pane after switch', { ...resumed, configDir: resumed.configDir?.replace(root, '$T'), cwd: resumed.cwd.replace(root, '$T') })
+    log('unrelated fresh launch after switch', { configDir: unrelated.configDir?.replace(root, '$T') })
+    expect(runningSeen.every((x) => x.configDir === homeA)).toBe(true)
+    expect(resumed.configDir).toBe(homeB)
+    expect(resumed.argv).toEqual(['--resume', 'sess-worker-1'])
+    expect(resumed.cwd.endsWith('worktree-original')).toBe(true)
+    expect(unrelated.configDir).toBe(homeB) // the default moved for everyone
+
+    // Switch back before a queued restart runs: it lands on whatever is selected then.
+    select('acct_a')
+    expect(paneRun(paneEnv, ['--resume', 'sess-worker-1']).configDir).toBe(homeA)
+  })
+
+  it('a pane-level CLAUDE_CONFIG_DIR without Orca\'s injected marker wins over the pointer (stock shell function)', () => {
+    const homeB = settings.claudeManagedAccounts[1]!.managedAuthPath
+    select('acct_a')
+    const env = { ...(router.terminalEnv() as Record<string, string>), CLAUDE_CONFIG_DIR: homeB, ORCA_CLAUDE_INJECTED_CONFIG_DIR: '' }
+    const r = paneRun(env, ['--resume', 'sess-worker-1'])
+    log('pane override', { configDir: r.configDir?.replace(root, '$T') })
+    expect(r.configDir).toBe(homeB)
+  })
+
+  it('account folders link one shared projects folder, so the same transcript file is reachable from either account', async () => {
+    const report = createClaudeProfileReport()
+    const defaultHome = join(userHome, '.claude')
+    for (const a of settings.claudeManagedAccounts) {
+      log(`merge projects ${a.id}`, await mergeClaudeProfileDirectory(a.managedAuthPath, defaultHome, 'projects', process.platform, report))
+    }
+    const homeA = settings.claudeManagedAccounts[0]!.managedAuthPath
+    const homeB = settings.claudeManagedAccounts[1]!.managedAuthPath
+    const rel = join('projects', '-synthetic-worktree', 'sess-worker-1.jsonl')
+    mkdirSync(join(homeA, 'projects', '-synthetic-worktree'), { recursive: true })
+    writeFileSync(join(homeA, rel), '{"type":"synthetic"}\n')
+    expect(existsSync(join(homeB, rel))).toBe(true)
+    // The hook-reported transcript path names the account folder the process actually used.
+    const saved = settings.claudeManagedAccounts
+    log('folder from transcript path under B', resolveClaudePaneFolder(join(homeB, rel), saved, undefined, process.platform))
+    log('folder from transcript path under A', resolveClaudePaneFolder(join(homeA, rel), saved, undefined, process.platform))
+    expect(resolveClaudePaneFolder(join(homeB, rel), saved, undefined, process.platform)).toEqual({ kind: 'account', accountId: 'acct_b' })
+  })
+})
+
+describe('PROBE B: resume command and the renderer restart queue (stock)', () => {
+  it('builds exact-session resume commands', () => {
+    const claude = buildAgentResumeStartupPlan({ agent: 'claude', providerSession: { key: 'session_id', id: 'sess-worker-1' }, cmdOverrides: {}, platform: 'darwin', launchCwd: '/synthetic/worktree' })
+    const codex = buildAgentResumeStartupPlan({ agent: 'codex', providerSession: { key: 'session_id', id: 'thread-1' }, cmdOverrides: {}, platform: 'darwin', launchCwd: '/synthetic/worktree' })
+    log('claude resume', claude?.launchCommand)
+    log('codex resume', codex?.launchCommand)
+    expect(claude?.launchCommand).toContain('--resume')
+    expect(claude?.launchCommand).toContain('sess-worker-1')
+    expect(codex?.launchCommand).toContain('resume')
+    expect(codex?.launchCommand).toContain('thread-1')
+  })
+
+})
+
+describe('PROBE C: included-usage reading at 100% with paid credits left (stock)', () => {
+  const at100 = (extra: ProviderRateLimits['extraUsage']): ProviderRateLimits =>
+    ({ provider: 'claude', session: { usedPercent: 100, windowMinutes: 300, resetsAt: Date.now() + 3_600_000, resetDescription: null }, weekly: null, monthly: null, extraUsage: extra }) as never
+  it('reads as room while paid credits remain; spent only when overage is off or empty', () => {
+    const paid = at100({ enabled: true, disabledReason: null, resetsAt: null, unit: 'credits', balance: 25, unlimited: false })
+    const off = at100({ enabled: false, disabledReason: null, resetsAt: null, unit: 'credits', balance: 25, unlimited: false })
+    const empty = at100({ enabled: true, disabledReason: null, resetsAt: null, unit: 'credits', balance: 0, unlimited: false })
+    const r = {
+      paidLeft: { room: rateLimitShowsRoom(paid), spentUntil: rateLimitSpentUntil(paid) ?? 'undefined' },
+      overageOff: { room: rateLimitShowsRoom(off), spentUntil: typeof rateLimitSpentUntil(off) },
+      overageEmpty: { room: rateLimitShowsRoom(empty), spentUntil: typeof rateLimitSpentUntil(empty) }
+    }
+    log('100% included', r)
+    expect(r.paidLeft.room).toBe(true)
+    expect(r.overageOff.room).toBe(false)
+    expect(r.overageEmpty.room).toBe(false)
+  })
+})
diff --git a/src/main/account-switch-probe/targeted-seam.probe.test.ts b/src/main/account-switch-probe/targeted-seam.probe.test.ts
