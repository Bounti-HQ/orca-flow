@@ -0,0 +1,76 @@
+// PROBE (not for upstream): what an in-place pane replacement — the stop that
+// restartAgentPaneInPlace issues, marked 'replaced' — does to a worker's Dispatch,
+// a coordinator's Run, the pane's terminal handle and an unrelated worker.
+// Real OrcaRuntimeService + in-memory OrchestrationDb; synthetic ids only.
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { OrcaRuntimeService } from '../runtime/orca-runtime'
+import { OrchestrationDb } from '../runtime/orchestration/db/orchestration-db'
+import { createRootDispatch } from '../runtime/orchestration/db/root-dispatch-test-fixture'
+
+const W_LEAF = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'
+const U_LEAF = 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb'
+const C_LEAF = 'cccccccc-cccc-4ccc-8ccc-cccccccccccc'
+const W_PANE = `tab_w:${W_LEAF}`
+const U_PANE = `tab_u:${U_LEAF}`
+const C_PANE = `tab_c:${C_LEAF}`
+
+type Row = Record<string, unknown>
+
+describe('PROBE: in-place replacement of a supervised pane (stock 1.4.272)', () => {
+  let db: OrchestrationDb
+  let runtime: OrcaRuntimeService
+  let runId: string
+  let workerDispatch: string
+  let unrelatedDispatch: string
+
+  const dispatch = (id: string): Row =>
+    db.db.prepare('SELECT * FROM dispatch_contexts WHERE id = ?').get(id) as Row
+  const run = (): Row => db.db.prepare('SELECT * FROM runs WHERE id = ?').get(runId) as Row
+  const mail = (): Row[] =>
+    db.db.prepare('SELECT * FROM messages ORDER BY rowid').all() as Row[]
+
+  beforeEach(() => {
+    db = new OrchestrationDb(':memory:')
+    runtime = new OrcaRuntimeService(null)
+    runtime.setOrchestrationDb(db)
+    runtime.registerPty('pty-c', 'wt', null, { tabId: 'tab_c', leafId: C_LEAF, terminalHandle: 'term_c', incarnationId: 'inc-c1' as never })
+    runtime.registerPty('pty-w1', 'wt', null, { tabId: 'tab_w', leafId: W_LEAF, terminalHandle: 'term_w', incarnationId: 'inc-w1' as never })
+    runtime.registerPty('pty-u', 'wt', null, { tabId: 'tab_u', leafId: U_LEAF, terminalHandle: 'term_u', incarnationId: 'inc-u1' as never })
+    runId = db.createRun({ objective: 'probe', coordinatorHandle: 'term_c', coordinatorPaneKey: C_PANE, coordinatorOrcaSessionId: null }).id
+    const task = db.createTask({ spec: 'synthetic worker task', runId })
+    workerDispatch = createRootDispatch(db, task.id, 'term_w', W_PANE, undefined, 'inc-w1').id
+    const other = db.createTask({ spec: 'unrelated concurrent task', runId })
+    unrelatedDispatch = createRootDispatch(db, other.id, 'term_u', U_PANE, undefined, 'inc-u1').id
+  })
+  afterEach(() => db.close())
+
+  it('worker: the replaced process exit settles its Dispatch even when marked as a restart in place', async () => {
+    const before = { status: dispatch(workerDispatch).status, mail: mail().length }
+    // Exactly what restartAgentPaneInPlace does before stopAndWait (restart-agent-pane-in-place.ts:150).
+    const settle = runtime.intentionalPtyStops.mark('pty-w1', 'replaced', 'inc-w1' as never)
+    settle(true)
+    await runtime.onPtyExit('pty-w1', 0, 'inc-w1' as never)
+    const after = dispatch(workerDispatch)
+    const newMail = mail().slice(before.mail)
+    console.log('[probe] worker dispatch', JSON.stringify({ before: before.status, after: after.status, error: after.last_error ?? after.error ?? null }))
+    console.log('[probe] mail written by the exit', JSON.stringify(newMail.map((m) => ({ type: m.type, subject: m.subject, to: m.to_handle ?? m.recipient }))))
+    // Replacement PTY in the same tab/leaf, as createRuntimeOwnedMobileSessionTerminal({identity}) would register it.
+    runtime.registerPty('pty-w2', 'wt', null, { tabId: 'tab_w', leafId: W_LEAF, incarnationId: 'inc-w2' as never })
+    const handleNow = runtime.getTerminalHandleForPaneKey(W_PANE)
+    console.log('[probe] pane handle after replacement', JSON.stringify({ handleNow, oldHandleLivePane: runtime.getLiveTerminalPaneKey('term_w') }))
+    // Observation recorded, not asserted as desirable:
+    expect(before.status).not.toBe(after.status)
+    expect(['failed', 'circuit_broken', 'completed', 'dispatched']).toContain(after.status)
+    // The unrelated worker is untouched.
+    expect(dispatch(unrelatedDispatch).status).toBe(dispatch(unrelatedDispatch).status)
+    console.log('[probe] unrelated dispatch', JSON.stringify({ status: dispatch(unrelatedDispatch).status, pane: dispatch(unrelatedDispatch).assignee_pane_key }))
+  })
+
+  it('coordinator: a replaced coordinator pane keeps its Run bound; an unmarked exit does not', async () => {
+    runtime.intentionalPtyStops.mark('pty-c', 'replaced', 'inc-c1' as never)(true)
+    await runtime.onPtyExit('pty-c', 0, 'inc-c1' as never)
+    const kept = run()
+    console.log('[probe] run after replaced coordinator exit', JSON.stringify({ status: kept.status, handle: kept.coordinator_handle, pane: kept.coordinator_pane_key }))
+    expect(kept.coordinator_pane_key).toBe(C_PANE)
+  })
+})
diff --git a/src/main/account-switch-probe/stock-switch-semantics.probe.test.ts b/src/main/account-switch-probe/stock-switch-semantics.probe.test.ts
