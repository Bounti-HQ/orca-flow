@@ -0,0 +1,137 @@
+// PROBE (not for upstream): the targeted seam on branch probe/targeted-pane-account-seam.
+// Synthetic managed identities, temp homes, a fixture `claude` executable, in-memory orchestration.
+import { execFileSync } from 'node:child_process'
+import { chmodSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterAll, afterEach, beforeAll, describe, expect, it } from 'vitest'
+import { ClaudeProfileRouter, type ClaudeProfileRouterSettings } from '../claude-accounts/profiles/routing/claude-profile-router'
+import { installClaudeProfileRouter, withClaudeProfileTerminalEnv } from '../claude-accounts/profiles/routing/claude-profile-installed-router'
+import { getPosixClaudeShellFunction } from '../../shared/shell/launch/agents/claude-shell-function'
+import { OrcaRuntimeService } from '../runtime/orca-runtime'
+import { OrchestrationDb } from '../runtime/orchestration/db/orchestration-db'
+import { restartResumedCallerHandle } from '../runtime/rpc/methods/orchestration/access/restart-resumed-caller'
+
+const log = (label: string, value: unknown): void => console.log(`[probe] ${label} ${JSON.stringify(value)}`)
+
+describe('SEAM A: one pane pinned to a target account; the host default untouched', () => {
+  let root: string, dataRoot: string, userHome: string, worktree: string, fnFile: string, binDir: string
+  let settings: ClaudeProfileRouterSettings
+  let router: ClaudeProfileRouter
+  const acct = (id: string) => ({ id, email: `${id}@example.invalid`, managedAuthPath: join(dataRoot, 'claude-profiles', id, 'home'), authMethod: 'subscription-oauth' as const, createdAt: 1, updatedAt: 1, lastAuthenticatedAt: 1 })
+  const select = (id: string) => {
+    settings = { ...settings, activeClaudeManagedAccountId: id, activeClaudeManagedAccountIdsByRuntime: { host: id, wsl: {} } } as never
+    router.publish()
+  }
+  const paneRun = (env: Record<string, string>, args: string[]) =>
+    JSON.parse(execFileSync('/bin/bash', ['-c', `source "${fnFile}"; cd "${worktree}"; claude "$@"`, 'pane', ...args], { env: { PATH: `${binDir}:/usr/bin:/bin`, HOME: userHome, ...env }, encoding: 'utf8' }).trim())
+  const short = (p: string | null) => (p ? p.replace(root, '$T').replace('/private$T', '$T') : p)
+
+  beforeAll(() => {
+    root = mkdtempSync(join(tmpdir(), 'orca-seam-probe-'))
+    dataRoot = join(root, 'orca-data'); userHome = join(root, 'home'); worktree = join(root, 'worktree-original'); binDir = join(root, 'bin')
+    for (const d of [dataRoot, userHome, worktree, binDir]) mkdirSync(d, { recursive: true })
+    writeFileSync(join(binDir, 'claude'), `#!${process.execPath}\nprocess.stdout.write(JSON.stringify({configDir:process.env.CLAUDE_CONFIG_DIR??null,argv:process.argv.slice(2),cwd:process.cwd(),pin:process.env.ORCA_CLAUDE_PINNED_ACCOUNT_ID??null})+'\\n')\n`)
+    chmodSync(join(binDir, 'claude'), 0o755)
+    fnFile = join(root, 'fn.sh'); writeFileSync(fnFile, getPosixClaudeShellFunction())
+    settings = { claudeManagedAccounts: [acct('acct_a'), acct('acct_b')], activeClaudeManagedAccountId: 'acct_a', activeClaudeManagedAccountIdsByRuntime: { host: 'acct_a', wsl: {} }, agentStatusHooksEnabled: false, disabledTuiAgents: [] } as never
+    for (const a of settings.claudeManagedAccounts) mkdirSync(a.managedAuthPath, { recursive: true })
+    router = new ClaudeProfileRouter({ getSettings: () => settings, dataRoot, userHome, env: { HOME: userHome }, runSetup: async () => ({ outcome: 'prepared', warnings: [] }) as never })
+    installClaudeProfileRouter(router)
+  })
+  afterAll(() => { installClaudeProfileRouter(undefined); rmSync(root, { recursive: true, force: true }) })
+
+  it('the spawn preflight merge pins pane W to acct_b; an unrelated concurrent launch keeps the default; later switches move only the unpinned pane', () => {
+    select('acct_a')
+    const homeA = settings.claudeManagedAccounts[0]!.managedAuthPath
+    const homeB = settings.claudeManagedAccounts[1]!.managedAuthPath
+    // What restartAgentPaneInPlace(…, { accountId: 'acct_b' }) puts in the create env, through the
+    // same function both spawn preflights call (spawn-preflight.ts:103 / ipc/spawn-preflight.ts:119).
+    const paneW = withClaudeProfileTerminalEnv({ ORCA_CLAUDE_PINNED_ACCOUNT_ID: 'acct_b', KEEP: '1' }, { runtime: 'host' }) as Record<string, string>
+    const paneU = withClaudeProfileTerminalEnv({}, { runtime: 'host' }) as Record<string, string>
+    log('pane W env', { pointer: short(paneW.ORCA_CLAUDE_PROFILE_POINTER!), CLAUDE_CONFIG_DIR: short(paneW.CLAUDE_CONFIG_DIR!), marker: paneW.ORCA_CLAUDE_PINNED_ACCOUNT_ID ?? null, KEEP: paneW.KEEP })
+    const w1 = paneRun(paneW, ['--resume', 'sess-worker-1'])
+    const u1 = paneRun(paneU, [])
+    select('acct_b'); const u2 = paneRun(paneU, []); const w2 = paneRun(paneW, ['--resume', 'sess-worker-1'])
+    select('acct_a'); const u3 = paneRun(paneU, []); const w3 = paneRun(paneW, ['--resume', 'sess-worker-1'])
+    log('W/U across host selections a→b→a', { W: [w1, w2, w3].map((r) => short(r.configDir)), U: [u1, u2, u3].map((r) => short(r.configDir)), Wargv: w1.argv, Wcwd: short(w1.cwd), pinReachedAgent: w1.pin })
+    expect([w1, w2, w3].every((r) => r.configDir === homeB)).toBe(true)
+    expect([u1.configDir, u2.configDir, u3.configDir]).toEqual([homeA, homeB, homeA])
+    expect(w1.argv).toEqual(['--resume', 'sess-worker-1'])
+    expect(w1.pin).toBeNull()
+    expect(readFileSync(router.pointerPath, 'utf8')).toBe(homeA) // host default never touched by the pin
+  })
+
+  it('refuses an unknown account or a WSL target instead of falling back', () => {
+    expect(() => withClaudeProfileTerminalEnv({ ORCA_CLAUDE_PINNED_ACCOUNT_ID: 'acct_zz' }, { runtime: 'host' })).toThrow('claude_pinned_account_unknown')
+    expect(() => withClaudeProfileTerminalEnv({ ORCA_CLAUDE_PINNED_ACCOUNT_ID: 'acct_b' }, { runtime: 'wsl', wslDistro: 'x' } as never)).toThrow('claude_pinned_account_unavailable')
+  })
+})
+
+describe('SEAM B: the worker Dispatch through an in-place replacement', () => {
+  const W_LEAF = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'
+  const U_LEAF = 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb'
+  const W_PANE = `tab_w:${W_LEAF}`
+  const U_PANE = `tab_u:${U_LEAF}`
+  let db: OrchestrationDb
+  let runtime: OrcaRuntimeService
+  let runId: string
+  const row = (id: string) => db.db.prepare('SELECT id, status, assignee_handle, assignee_pane_key, process_incarnation FROM dispatch_contexts WHERE id = ?').get(id) as Record<string, unknown>
+  const stage = (id: string) => (db.db.prepare('SELECT stage FROM worker_dispatches WHERE dispatch_id = ?').get(id) as { stage?: string } | undefined)?.stage ?? null
+  const mail = () => db.db.prepare('SELECT type, subject, to_handle FROM messages ORDER BY rowid').all() as Record<string, unknown>[]
+
+  function worker(handle: string, paneKey: string, incarnation: string, session: string): string {
+    const task = db.createTask({ spec: `synthetic ${handle}`, runId })
+    const { dispatch } = db.createStartingWorkerDispatch({ creator: { kind: 'system' }, maxDepth: Number.MAX_SAFE_INTEGER, taskId: task.id, startOptions: { topology: 'current', agent: 'claude' } })
+    db.prepareStartingWorkerAuthority({ dispatchId: dispatch.id, handle, paneKey, processIncarnation: incarnation, worktreeId: 'wt', setupState: 'not_applicable', effects: [], terminalOwnership: 'created' })
+    db.markWorkerDispatchReady(dispatch.id)
+    db.db.prepare('UPDATE worker_terminal_resources SET resume_session = ? WHERE owner_dispatch_id = ?').run(JSON.stringify({ agent: 'claude', providerSession: { key: 'session_id', id: session }, connectionId: null }), dispatch.id)
+    db.db.prepare('INSERT INTO worker_presence (dispatch_id, presence, generation) VALUES (?, ?, 1)').run(dispatch.id, 'working')
+    return dispatch.id
+  }
+
+  function setup(resumeWorkOnRestart: boolean) {
+    db = new OrchestrationDb(':memory:')
+    const store = resumeWorkOnRestart ? ({ getSettings: () => ({ nativeChatResumeWorkOnRestart: true }) } as never) : null
+    runtime = new OrcaRuntimeService(store)
+    runtime.setOrchestrationDb(db)
+    runtime.registerPty('pty-w1', 'wt', null, { tabId: 'tab_w', leafId: W_LEAF, terminalHandle: 'term_w', incarnationId: 'inc-w1' as never })
+    runtime.registerPty('pty-u', 'wt', null, { tabId: 'tab_u', leafId: U_LEAF, terminalHandle: 'term_u', incarnationId: 'inc-u1' as never })
+    runId = db.createRun({ objective: 'seam', coordinatorHandle: 'term_c', coordinatorPaneKey: 'tab_c:cccccccc-cccc-4ccc-8ccc-cccccccccccc', coordinatorOrcaSessionId: null }).id
+  }
+  afterEach(() => db?.close())
+
+  for (const resumeWorkOnRestart of [false, true]) {
+    it(`replaced exit holds the Dispatch; only the pane's own conversation rebinds it (Resume work on restart=${resumeWorkOnRestart})`, async () => {
+      setup(resumeWorkOnRestart)
+      const w = worker('term_w', W_PANE, (runtime as never as { getTerminalProcessIncarnation(h: string): string }).getTerminalProcessIncarnation('term_w'), 'sess-worker-1')
+      const u = worker('term_u', U_PANE, (runtime as never as { getTerminalProcessIncarnation(h: string): string }).getTerminalProcessIncarnation('term_u'), 'sess-unrelated')
+      const before = { w: row(w), u: row(u), mail: mail().length }
+      runtime.intentionalPtyStops.mark('pty-w1', 'replaced', 'inc-w1' as never)(true)
+      await runtime.onPtyExit('pty-w1', 0, 'inc-w1' as never)
+      await runtime.onPtyExit('pty-w1', 0, 'inc-w1' as never) // duplicate exit report (replay)
+      const held = { status: row(w).status, stage: stage(w), mail: mail().slice(before.mail) }
+      log(`[rwor=${resumeWorkOnRestart}] after replaced exit`, held)
+      // The new terminal in the same tab/leaf.
+      runtime.registerPty('pty-w2', 'wt', null, { tabId: 'tab_w', leafId: W_LEAF, incarnationId: 'inc-w2' as never })
+      const resume = (runtime as never as { terminalWorkerRestartResume: { observePaneAgents(s: { paneKey: string; sessionId: string }[]): void; isHeld(id: string): boolean } }).terminalWorkerRestartResume
+      resume.observePaneAgents([{ paneKey: W_PANE, sessionId: 'sess-someone-else' }])
+      await new Promise((r) => setTimeout(r, 50))
+      const afterOther = { assignee: row(w).assignee_handle, held: resume.isHeld(w) }
+      resume.observePaneAgents([{ paneKey: W_PANE, sessionId: 'sess-worker-1' }])
+      resume.observePaneAgents([{ paneKey: W_PANE, sessionId: 'sess-worker-1' }]) // duplicate hook report
+      await new Promise((r) => setTimeout(r, 200))
+      const bound = row(w)
+      const newHandle = runtime.getTerminalHandleForPaneKey(W_PANE)
+      const staleCaller = restartResumedCallerHandle(runtime as never, 'term_w', { paneKey: W_PANE } as never)
+      log(`[rwor=${resumeWorkOnRestart}] rebinding`, { afterOther, bound: { status: bound.status, assignee: bound.assignee_handle, pane: bound.assignee_pane_key, incarnation: bound.process_incarnation }, paneHandle: newHandle, staleTermWResolvesTo: staleCaller, stage: stage(w), mailNow: mail().slice(before.mail) })
+      log(`[rwor=${resumeWorkOnRestart}] unrelated worker`, { before: before.u.status, after: row(u).status, assignee: row(u).assignee_handle })
+      expect(held.status).not.toBe('failed')
+      expect(held.mail).toEqual([])
+      expect(afterOther.assignee).toBe('term_w')
+      expect(bound.assignee_handle).toBe(newHandle)
+      expect(bound.assignee_pane_key).toBe(W_PANE)
+      expect(row(u)).toEqual(before.u)
+    })
+  }
+})
